# 智能客服多Agent系统 · 环境变量模板
# 用法：复制为 .env 后填写真实值；.env 不得提交到版本库（见 .gitignore）
# 注意：本文件不含任何真实密钥

# ===== LLM 云端 API Key（必填：缺失时应用启动即失败，fail fast）=====
# 注意：本模板仅放占位符；真实密钥请填入 .env（已被 .gitignore 排除）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
MIMO_API_KEY=your_mimo_api_key_here

# ===== 模型路由（有默认值，一般无需修改）=====
MODEL_MAIN=deepseek-v4-flash
MODEL_FALLBACK=mimo-v2.5
MODEL_VISION=mimo-v2.5

# ===== 外部依赖 =====
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/smart_agent
REDIS_URL=redis://localhost:6379/0
ES_HOST=http://localhost:9200

# ===== Embedding（硅基流动 bge-m3 云端 API；选填，M1 索引 / M2 检索时使用）=====
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_KEY=your_siliconflow_api_key_here
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1

# ===== 重排（硅基流动 bge-reranker-v2-m3 云端 API；选填，M2 重排时使用）=====
RERANKER_MODEL=bge-reranker-v2-m3
RERANKER_API_KEY=your_siliconflow_api_key_here
RERANKER_BASE_URL=https://api.siliconflow.cn/v1

# ===== MinerU 云端文档解析（mineru.net；选填，M1 解析 PDF/Word 时使用）=====
MINERU_API_KEY=your_mineru_api_key_here
MINERU_BASE_URL=https://mineru.net
